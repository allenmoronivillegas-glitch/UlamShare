rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGuest() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? userDoc().data.role
        : '';
    }

    function userRoleKey() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? userDoc().data.roleKey
        : '';
    }

    function tokenRole() {
      return signedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : '';
    }

    function isAdminRole(role) {
      return role in [
        'Admin',
        'admin',
        'ADMIN',
        'Super Admin',
        'super admin',
        'SuperAdmin',
        'super_admin',
        'SUPER_ADMIN',
        'superadmin'
      ];
    }

    function isAdmin() {
      return signedIn() && (isAdminRole(userRole()) || isAdminRole(userRoleKey()) || isAdminRole(tokenRole()));
    }

    function isModeratorRole(role) {
      return role in [
        'Moderator',
        'moderator',
        'MODERATOR',
        'mod'
      ];
    }

    function isAdminOrModerator() {
      return signedIn()
        && (
          isAdminRole(userRole())
          || isAdminRole(userRoleKey())
          || isAdminRole(tokenRole())
          || isModeratorRole(userRole())
          || isModeratorRole(userRoleKey())
          || isModeratorRole(tokenRole())
        );
    }

    function validCreatedModerationStatus() {
      return !request.resource.data.keys().hasAny(['moderationStatus'])
        || request.resource.data.moderationStatus == 'active';
    }

    function moderationFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'moderationStatus',
        'hiddenAt',
        'hiddenBy',
        'deletedAt',
        'deletedBy',
        'updatedAt'
      ]);
    }

    function doesNotChangeModerationFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'moderationStatus',
        'hiddenAt',
        'hiddenBy',
        'deletedAt',
        'deletedBy'
      ]);
    }

    function validModerationStatusUpdate() {
      return request.resource.data.moderationStatus in ['active', 'hidden', 'deleted'];
    }

    function canModerateContentUpdate() {
      return isAdminOrModerator()
        && moderationFieldsOnly()
        && validModerationStatusUpdate();
    }

    function feedSettings() {
      return get(/databases/$(database)/documents/app_settings/campaign_feed).data;
    }

    function hasFeedSettings() {
      return exists(/databases/$(database)/documents/app_settings/campaign_feed);
    }

    function allowUserPosts() {
      return !hasFeedSettings() || feedSettings().allowUserPosts == true;
    }

    function allowGuestPosts() {
      return hasFeedSettings() && feedSettings().allowGuestPosts == true;
    }

    function allowGuestReactions() {
      return !hasFeedSettings() || feedSettings().allowGuestReactions == true;
    }

    function allowGuestComments() {
      return !hasFeedSettings() || feedSettings().allowGuestComments == true;
    }

    function validPostBase(postId) {
      return signedIn()
        && request.resource.data.id == postId
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'id',
          'authorId',
          'authorName',
          'authorRole',
          'category',
          'postType',
          'text',
          'imageUrl',
          'campaignTitle',
          'campaignGoal',
          'campaignRaised',
          'campaignStatus',
          'createdAt',
          'updatedAt',
          'reactCount',
          'commentCount',
          'shareCount',
          'isLiveCampaign'
        ]);
    }

    function isCommunityCreate(postId) {
      return validPostBase(postId)
        && request.resource.data.category == 'community'
        && request.resource.data.postType in ['note', 'photo']
        && request.resource.data.isLiveCampaign == false
        && validCreatedModerationStatus();
    }

    function canCreatePost(postId) {
      return isAdminOrModerator()
        && validPostBase(postId)
        && (request.resource.data.category in ['community', 'official'])
        && (request.resource.data.postType in ['note', 'photo', 'live_campaign'])
        && validCreatedModerationStatus()
        || (
          signedIn()
          && !isGuest()
          && allowUserPosts()
          && isCommunityCreate(postId)
          && request.resource.data.authorRole in ['user', 'moderator']
        )
        || (
          isGuest()
          && allowGuestPosts()
          && isCommunityCreate(postId)
          && request.resource.data.authorRole == 'guest'
        );
    }

    function canUpdatePostCounters() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reactCount', 'reactionCounts', 'commentCount', 'shareCount', 'updatedAt']);
    }

    function canUpdateOwnPost() {
      return signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.category == resource.data.category
        && request.resource.data.authorRole == resource.data.authorRole
        && request.resource.data.postType == resource.data.postType
        && doesNotChangeModerationFields();
    }

    function canManagePost(postId) {
      return isAdminOrModerator()
        || (
          signedIn()
          && get(/databases/$(database)/documents/campaign_posts/$(postId)).data.authorId == request.auth.uid
        );
    }

    function isSafeOwnUserUpdate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roleKey']);
    }

    function isFollowerCountMirrorUpdate(userId) {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])
        && (
          exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
          || existsAfter(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
        );
    }

    function isFriendCountMirrorUpdate(userId) {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendsCount'])
        && (
          exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid))
          || existsAfter(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid))
        );
    }

    function isValidFollowRecord(expectedUserId) {
      return request.resource.data.userId == expectedUserId
        && request.resource.data.keys().hasAll(['userId', 'fullName', 'followedAt'])
        && request.resource.data.keys().hasOnly([
          'userId',
          'fullName',
          'email',
          'profilePhotoUrl',
          'profilePhotoLocalUri',
          'role',
          'status',
          'followedAt'
        ]);
    }

    function isValidFriendRecord(expectedUserId) {
      return request.resource.data.userId == expectedUserId
        && request.resource.data.keys().hasAll(['userId', 'fullName', 'friendedAt'])
        && request.resource.data.keys().hasOnly([
          'userId',
          'fullName',
          'email',
          'profilePhotoUrl',
          'profilePhotoLocalUri',
          'role',
          'status',
          'friendedAt'
        ]);
    }

    function isValidPaymentMethod(methodId) {
      return request.resource.data.id == methodId
        && request.resource.data.type == methodId
        && request.resource.data.type in ['gcash', 'maya', 'card']
        && request.resource.data.displayName is string
        && request.resource.data.maskedNumber is string
        && request.resource.data.isDefault is bool
        && request.resource.data.keys().hasOnly([
          'id',
          'type',
          'displayName',
          'maskedNumber',
          'isDefault',
          'createdAt',
          'updatedAt'
        ]);
    }

    function isOwnDonationWrite() {
      return signedIn()
        && (
          request.resource.data.userId == request.auth.uid
          || request.resource.data.donorId == request.auth.uid
        )
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.campaignId is string;
    }

    function validReactionType(type) {
      return type in ['like', 'heart', 'haha', 'sad', 'care', 'angry'];
    }

    function canCreateCampaignComment(postId, commentId) {
      return signedIn()
        && request.resource.data.id == commentId
        && request.resource.data.postId == postId
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorRole in ['user', 'guest', 'admin', 'super_admin', 'moderator']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.replyCount == 0
        && validCreatedModerationStatus()
        && (!isGuest() || allowGuestComments());
    }

    function canCreateCampaignReply(postId, commentId, replyId) {
      return signedIn()
        && request.resource.data.id == replyId
        && request.resource.data.postId == postId
        && request.resource.data.parentCommentId == commentId
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorRole in ['user', 'guest', 'admin', 'super_admin', 'moderator']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && validCreatedModerationStatus()
        && (!isGuest() || allowGuestComments());
    }

    function canCreateOrUpdateReaction(actorId) {
      return signedIn()
        && actorId == request.auth.uid
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole in ['user', 'guest', 'admin', 'super_admin', 'moderator']
        && validReactionType(request.resource.data.type)
        && (!isGuest() || allowGuestReactions());
    }

    function canCreateNotification(notificationId) {
      return signedIn()
        && request.resource.data.id == notificationId
        && request.resource.data.senderId == request.auth.uid
        && (
          request.resource.data.recipientId != request.auth.uid
          || request.resource.data.type == 'donation_success'
        )
        && request.resource.data.type in [
          'donation_success',
          'new_donation_admin',
          'campaign_added',
          'campaign_updated',
          'friend_request',
          'friend_request_accepted',
          'friend_added',
          'friend_removed',
          'followed',
          'unfollowed',
          'mention_post',
          'mention_comment',
          'mention_reply',
          'post_comment',
          'comment_reply',
          'reply_reply',
          'post_reaction',
          'post_hidden',
          'post_deleted',
          'comment_hidden',
          'comment_deleted',
          'reply_hidden',
          'reply_deleted',
          'comment',
          'mention'
        ]
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.isRead == false;
    }

    match /app_settings/campaign_feed {
      allow read: if true;
      allow create, update: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && !request.resource.data.keys().hasAny(['role', 'roleKey'])
        );
      allow update: if isAdmin()
        || isSafeOwnUserUpdate(userId)
        || isFollowerCountMirrorUpdate(userId)
        || isFriendCountMirrorUpdate(userId)
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers'])
        );
      allow delete: if isAdmin();

      match /following/{targetUserId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && targetUserId != userId
          && isValidFollowRecord(targetUserId);
        allow delete: if signedIn()
          && request.auth.uid == userId
          && targetUserId != userId;
      }

      match /followers/{followerUserId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == followerUserId
          && followerUserId != userId
          && isValidFollowRecord(followerUserId);
        allow delete: if signedIn()
          && request.auth.uid == followerUserId
          && followerUserId != userId;
      }

      match /friends/{friendUserId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && userId != friendUserId
          && (request.auth.uid == userId || request.auth.uid == friendUserId)
          && isValidFriendRecord(friendUserId);
        allow delete: if signedIn()
          && userId != friendUserId
          && (request.auth.uid == userId || request.auth.uid == friendUserId);
      }

      match /payment_methods/{methodId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && isValidPaymentMethod(methodId);
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /donated_campaigns/{campaignId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /donations/{donationId} {
      allow read: if isAdminOrModerator()
        || (
          signedIn()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.donorId == request.auth.uid
          )
        );
      allow create, update: if isOwnDonationWrite();
      allow delete: if isAdminOrModerator();
    }

    match /friend_requests/{requestId} {
      allow read: if signedIn()
        && (
          resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid
          || isAdminOrModerator()
        );
      allow create: if signedIn()
        && request.resource.data.id == requestId
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && (
          resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid
          || isAdminOrModerator()
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'accepted', 'declined', 'cancelled'];
      allow delete: if isAdminOrModerator();
    }

    match /campaign_posts/{postId} {
      allow read: if true;
      allow create: if canCreatePost(postId);
      allow update: if isAdmin()
        || canModerateContentUpdate()
        || canUpdateOwnPost()
        || canUpdatePostCounters();
      allow delete: if canManagePost(postId);

      match /reactions/{reactionId} {
        allow read: if true;
        allow create, update: if canCreateOrUpdateReaction(reactionId);
        allow delete: if canManagePost(postId)
          || (signedIn() && reactionId == request.auth.uid);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if canCreateCampaignComment(postId, commentId);
        allow update: if isAdmin()
          || canModerateContentUpdate()
          || (
            signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount', 'updatedAt'])
            && (!isGuest() || allowGuestComments())
          );
        allow delete: if canManagePost(postId)
          || (
            signedIn()
            && (
              resource.data.authorId == request.auth.uid
              || resource.data.userId == request.auth.uid
            )
          );

        match /replies/{replyId} {
          allow read: if true;
          allow create: if canCreateCampaignReply(postId, commentId, replyId);
          allow update: if isAdmin()
            || canModerateContentUpdate()
            || (
              signedIn()
              && resource.data.authorId == request.auth.uid
              && doesNotChangeModerationFields()
            );
          allow delete: if canManagePost(postId)
            || (
              signedIn()
              && resource.data.authorId == request.auth.uid
            );
        }
      }
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.recipientId == request.auth.uid);
      allow create: if canCreateNotification(notificationId);
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.recipientId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        );
      allow delete: if isAdmin()
        || (signedIn() && resource.data.recipientId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
