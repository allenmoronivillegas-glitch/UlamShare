asFeedSettings() && feedSettings().allowGuestPosts == true;\n    }\n\n    function allowGuestReactions() {\n      return !hasFeedSettings() || feedSettings().allowGuestReactions == true;\n    }\n\n    function allowGuestComments() {\n      return !hasFeedSettings() || feedSettings().allowGuestComments == true;\n    }\n\n    function validPostBase(postId) {\n      return signedIn()\n        && request.resource.data.id == postId\n        && request.resource.data.authorId == request.auth.uid\n        && request.resource.data.keys().hasAll([\n          'id',\n          'authorId',\n          'authorName',\n          'authorRole',\n          'category',\n          'postType',\n          'text',\n          'imageUrl',\n          'campaignTitle',\n          'campaignGoal',\n          'campaignRaised',\n          'campaignStatus',\n          'createdAt',\n          'updatedAt',\n          'reactCount',\n          'commentCount',\n          'shareCount',\n          'isLiveCampaign'\n        ]);\n    }\n\n    function isCommunityCreate(postId) {\n      return validPostBase(postId)\n        && request.resource.data.category == 'community'\n        && request.resource.data.postType in ['note', 'photo']\n        && request.resource.data.isLiveCampaign == false;\n    }\n\n    function canCreatePost(postId) {\n      return isAdmin()\n        && validPostBase(postId)\n        && (request.resource.data.category in ['community', 'official'])\n        && (request.resource.data.postType in ['note', 'photo', 'live_campaign'])\n        || (\n          signedIn()\n          && !isGuest()\n          && allowUserPosts()\n          && isCommunityCreate(postId)\n          && request.resource.data.authorRole == 'user'\n        )\n        || (\n          isGuest()\n          && allowGuestPosts()\n          && isCommunityCreate(postId)\n          && request.resource.data.authorRole == 'guest'\n        );\n    }\n\n    function canUpdatePostCounters() {\n      return signedIn()\n        && request.resource.data.diff(resource.data).affectedKeys()\n          .hasOnly(['reactCount', 'reactionCounts', 'commentCount', 'shareCount', 'updatedAt']);\n    }\n\n    function canUpdateOwnPost() {\n      return signedIn()\n        && resource.data.authorId == request.auth.uid\n        && request.resource.data.authorId == resource.data.authorId\n        && request.resource.data.category == resource.data.category\n        && request.resource.data.authorRole == resource.data.authorRole\n        && request.resource.data.postType == resource.data.postType;\n    }\n\n    function canManagePost(postId) {\n      return isAdmin()\n        || (\n          signedIn()\n          && get(/databases/$(database)/documents/campaign_posts/$(postId)).data.authorId == request.auth.uid\n        );\n    }\n\n    function isSafeOwnUserUpdate(userId) {\n      return signedIn()\n        && request.auth.uid == userId\n        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roleKey']);\n    }\n\n    function isFollowerCountMirrorUpdate(userId) {\n      return signedIn()\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])\n        && (\n          exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))\n          || existsAfter(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))\n        );\n    }\n\n    function isValidFollowRecord(expectedUserId) {\n      return request.resource.data.userId == expectedUserId\n        && request.resource.data.keys().hasAll(['userId', 'fullName', 'followedAt'])\n        && request.resource.data.keys().hasOnly([\n          'userId',\n          'fullName',\n          'email',\n          'profilePhotoUrl',\n          'profilePhotoLocalUri',\n          'role',\n          'status',\n          'followedAt'\n        ]);\n    }\n\n    function validReactionType(type) {\n      return type in ['like', 'heart', 'haha', 'sad', 'care', 'angry'];\n    }\n\n    function canCreateCampaignComment(postId, commentId) {\n      return signedIn()\n        && request.resource.data.id == commentId\n        && request.resource.data.postId == postId\n        && request.resource.data.authorId == request.auth.uid\n        && request.resource.data.authorRole in ['user', 'guest', 'admin', 'super_admin']\n        && request.resource.data.text is string\n        && request.resource.data.text.size() > 0\n        && request.resource.data.replyCount == 0\n        && (!isGuest() || allowGuestComments());\n    }\n\n    function canCreateCampaignReply(postId, commentId, replyId) {\n      return signedIn()\n        && request.resource.data.id == replyId\n        && request.resource.data.postId == postId\n        && request.resource.data.parentCommentId == commentId\n        && request.resource.data.authorId == request.auth.uid\n        && request.resource.data.authorRole in ['user', 'guest', 'admin', 'super_admin']\n        && request.resource.data.text is string\n        && request.resource.data.text.size() > 0\n        && (!isGuest() || allowGuestComments());\n    }\n\n    function canCreateOrUpdateReaction(actorId) {\n      return signedIn()\n        && actorId == request.auth.uid\n        && request.resource.data.actorId == request.auth.uid\n        && request.resource.data.actorRole in ['user', 'guest', 'admin', 'super_admin']\n        && validReactionType(request.resource.data.type)\n        && (!isGuest() || allowGuestReactions());\n    }\n\n    function canCreateNotification(notificationId) {\n      return signedIn()\n        && request.resource.data.id == notificationId\n        && request.resource.data.senderId == request.auth.uid\n        && request.resource.data.recipientId != request.auth.uid\n        && request.resource.data.type in ['comment', 'comment_reply', 'reply_reply', 'post_reaction', 'mention']\n        && request.resource.data.message is string\n        && request.resource.data.message.size() > 0\n        && request.resource.data.isRead == false;\n    }\n\n    match /app_settings/campaign_feed {\n      allow read: if true;\n      allow create, update: if isAdmin();\n    }\n\n    match /users/{userId} {\n      allow read: if signedIn();\n      allow create: if isAdmin()\n        || (\n          signedIn()\n          && request.auth.uid == userId\n          && !request.resource.data.keys().hasAny(['role', 'roleKey'])\n        );\n      allow update: if isAdmin()\n        || isSafeOwnUserUpdate(userId)\n        || isFollowerCountMirrorUpdate(userId)\n        || (\n          signedIn()\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers'])\n        );\n      allow delete: if isAdmin();\n\n      match /following/{targetUserId} {\n        allow read: if signedIn();\n        allow create, update: if signedIn()\n          && request.auth.uid == userId\n          && targetUserId != userId\n          && isValidFollowRecord(targetUserId);\n        allow delete: if signedIn()\n          && request.auth.uid == userId\n          && targetUserId != userId;\n      }\n\n      match /followers/{followerUserId} {\n        allow read: if signedIn();\n        allow create, update: if signedIn()\n          && request.auth.uid == followerUserId\n          && followerUserId != userId\n          && isValidFollowRecord(followerUserId);\n        allow delete: if signedIn()\n          && request.auth.uid == followerUserId\n          && followerUserId != userId;\n      }\n    }\n\n    match /campaign_posts/{postId} {\n      allow read: if true;\n      allow create: if canCreatePost(postId);\n      allow update: if isAdmin() || canUpdateOwnPost() || canUpdatePostCounters();\n      allow delete: if canManagePost(postId);\n\n      match /reactions/{reactionId} {\n        allow read: if true;\n        allow create, update: if canCreateOrUpdateReaction(reactionId);\n        allow delete: if canManagePost(postId)\n          || (signedIn() && reactionId == request.auth.uid);\n      }\n\n      match /comments/{commentId} {\n        allow read: if true;\n        allow create: if canCreateCampaignComment(postId, commentId);\n        allow update: if isAdmin()\n          || (\n            signedIn()\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount', 'updatedAt'])\n            && (!isGuest() || allowGuestComments())\n          );\n        allow delete: if canManagePost(postId)\n          || (\n            signedIn()\n            && (\n              resource.data.authorId == request.auth.uid\n              || resource.data.userId == request.auth.uid\n            )\n          );\n\n        match /replies/{replyId} {\n          allow read: if true;\n          allow create: if canCreateCampaignReply(postId, commentId, replyId);\n          allow update, delete: if canManagePost(postId)\n            || (\n              signedIn()\n              && resource.data.authorId == request.auth.uid\n            );\n        }\n      }\n    }\n\n    match /notifications/{notificationId} {\n      allow read: if isAdmin()\n        || (signedIn() && resource.data.recipientId == request.auth.uid);\n      allow create: if canCreateNotification(notificationId);\n      allow update: if isAdmin()\n        || (\n          signedIn()\n          && resource.data.recipientId == request.auth.uid\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])\n        );\n      allow delete: if isAdmin()\n        || (signedIn() && resource.data.recipientId == request.auth.uid);\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-04-26T07:56:01.388143Z","metadata":{"services":["cloud.firestore"]}}
