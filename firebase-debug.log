[debug] [2026-04-25T11:14:35.960Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/ulamshare-4f2b9/rulesets {"name":"projects/ulamshare-4f2b9/rulesets/b8f0ad92-046d-4791-955f-a806203e59cf","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isGuest() {\n      return signedIn()\n        && request.auth.token.firebase.sign_in_provider == 'anonymous';\n    }\n\n    function userDoc() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid));\n    }\n\n    function userRole() {\n      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))\n        ? userDoc().data.role\n        : '';\n    }\n\n    function userRoleKey() {\n      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))\n        ? userDoc().data.roleKey\n        : '';\n    }\n\n    function tokenRole() {\n      return signedIn() && request.auth.token.role != null\n        ? request.auth.token.role\n        : '';\n    }\n\n    function isAdminRole(role) {\n      return role in [\n        'Admin',\n        'admin',\n        'ADMIN',\n        'Super Admin',\n        'super admin',\n        'SuperAdmin',\n        'super_admin',\n        'SUPER_ADMIN',\n        'superadmin'\n      ];\n    }\n\n    function isAdmin() {\n      return signedIn() && (isAdminRole(userRole()) || isAdminRole(userRoleKey()) || isAdminRole(tokenRole()));\n    }\n\n    function feedSettings() {\n      return get(/databases/$(database)/documents/app_settings/campaign_feed).data;\n    }\n\n    function hasFeedSettings() {\n      return exists(/databases/$(database)/documents/app_settings/campaign_feed);\n    }\n\n    function allowUserPosts() {\n      return !hasFeedSettings() || feedSettings().allowUserPosts == true;\n    }\n\n    function allowGuestPosts() {\n      return hasFeedSettings() && feedSettings().allowGuestPosts == true;\n    }\n\n    function allowGuestReactions() {\n      return !hasFeedSettings() || feedSettings().allowGuestReactions == true;\n    }\n\n    function allowGuestComments() {\n      return !hasFeedSettings() || feedSettings().allowGuestComments == true;\n    }\n\n    function validPostBase(postId) {\n      return signedIn()\n        && request.resource.data.id == postId\n        && request.resource.data.authorId == request.auth.uid\n        && request.resource.data.keys().hasAll([\n          'id',\n          'authorId',\n          'authorName',\n          'authorRole',\n          'category',\n          'postType',\n          'text',\n          'imageUrl',\n          'campaignTitle',\n          'campaignGoal',\n          'campaignRaised',\n          'campaignStatus',\n          'createdAt',\n          'updatedAt',\n          'reactCount',\n          'commentCount',\n          'shareCount',\n          'isLiveCampaign'\n        ]);\n    }\n\n    function isCommunityCreate(postId) {\n      return validPostBase(postId)\n        && request.resource.data.category == 'community'\n        && request.resource.data.postType in ['note', 'photo']\n        && request.resource.data.isLiveCampaign == false;\n    }\n\n    function isOfficialCreate(postId) {\n      return validPostBase(postId)\n        && request.resource.data.category == 'official'\n        && request.resource.data.authorRole in ['admin', 'super_admin']\n        && request.resource.data.postType in ['note', 'photo', 'live_campaign'];\n    }\n\n    function canCreatePost(postId) {\n      return isAdmin() && isOfficialCreate(postId)\n        || (\n          signedIn()\n          && !isGuest()\n          && allowUserPosts()\n          && isCommunityCreate(postId)\n          && request.resource.data.authorRole == 'user'\n        )\n        || (\n          isGuest()\n          && allowGuestPosts()\n          && isCommunityCreate(postId)\n          && request.resource.data.authorRole == 'guest'\n        );\n    }\n\n    function canUpdatePostCounters() {\n      return signedIn()\n        && request.resource.data.diff(resource.data).affectedKeys()\n          .hasOnly(['reactCount', 'commentCount', 'shareCount', 'updatedAt']);\n    }\n\n    function canUpdateOwnPost() {\n      return signedIn()\n        && resource.data.authorId == request.auth.uid\n        && request.resource.data.authorId == resource.data.authorId\n        && request.resource.data.category == resource.data.category\n        && request.resource.data.authorRole == resource.data.authorRole\n        && request.resource.data.postType == resource.data.postType\n        && request.resource.data.diff(resource.data).affectedKeys()\n          .hasOnly(['text', 'imageUrl', 'updatedAt']);\n    }\n\n    function canManagePost(postId) {\n      return isAdmin()\n        || (\n          signedIn()\n          && get(/databases/$(database)/documents/campaign_posts/$(postId)).data.authorId == request.auth.uid\n          && (!isGuest() || allowGuestPosts())\n        );\n    }\n\n    match /app_settings/campaign_feed {\n      allow read: if true;\n      allow create, update: if isAdmin();\n    }\n\n    match /users/{userId} {\n      allow read: if signedIn();\n      allow create: if isAdmin()\n        || (\n          signedIn()\n          && request.auth.uid == userId\n          && !request.resource.data.keys().hasAny(['role', 'roleKey'])\n        );\n      allow update: if isAdmin()\n        || (\n          signedIn()\n          && request.auth.uid == userId\n          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roleKey'])\n        )\n        || (\n          signedIn()\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers'])\n        );\n      allow delete: if isAdmin();\n    }\n\n    match /campaign_posts/{postId} {\n      allow read: if true;\n      allow create: if canCreatePost(postId);\n      allow update: if isAdmin() || canUpdateOwnPost() || canUpdatePostCounters();\n      allow delete: if canManagePost(postId);\n\n      match /reactions/{reactionId} {\n        allow read: if true;\n        allow create: if signedIn()\n          && reactionId == request.auth.uid\n          && request.resource.data.userId == request.auth.uid\n          && (!isGuest() || allowGuestReactions());\n        allow delete: if canManagePost(postId)\n          || (signedIn() && reactionId == request.auth.uid);\n      }\n\n      match /comments/{commentId} {\n        allow read: if true;\n        allow create: if signedIn()\n          && request.resource.data.userId == request.auth.uid\n          && (!isGuest() || allowGuestComments());\n        allow update, delete: if canManagePost(postId)\n          || (signedIn() && resource.data.userId == request.auth.uid);\n      }\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-04-25T11:14:29.347951Z","metadata":{"services":["cloud.firestore"]}}
