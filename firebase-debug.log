[debug] [2026-05-02T11:34:09.115Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/ulamshare-4f2b9/rulesets {"name":"projects/ulamshare-4f2b9/rulesets/76e09194-ef95-45c0-9dc0-e146bba55b34","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isGuest() {\n      return signedIn()\n        && request.auth.token.firebase.sign_in_provider == 'anonymous';\n    }\n\n    function userDoc() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid));\n    }\n\n    function userRole() {\n      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))\n        ? userDoc().data.role\n        : '';\n    }\n\n    function userRoleKey() {\n      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))\n        ? userDoc().data.roleKey\n        : '';\n    }\n\n    function tokenRole() {\n      return signedIn() && request.auth.token.role != null\n        ? request.auth.token.role\n        : '';\n    }\n\n    function isAdminRole(role) {\n      return role in [\n        'Admin',\n        'admin',\n        'ADMIN',\n        'Super Admin',\n        'super admin',\n        'SuperAdmin',\n        'super_admin',\n        'SUPER_ADMIN',\n        'superadmin'\n      ];\n    }\n\n    function isAdmin() {\n      return signedIn() && (isAdminRole(userRole()) || isAdminRole(userRoleKey()) || isAdminRole(tokenRole()));\n    }\n\n    function isModeratorRole(role) {\n      return role in [\n        'Moderator',\n        'moderator',\n        'MODERATOR',\n        'mod'\n      ];\n    }\n\n    function isAdminOrModerator() {\n      return signedIn()\n        && (\n          isAdminRole(userRole())\n          || isAdminRole(userRoleKey())\n          || isAdminRole(tokenRole())\n          || isModeratorRole(userRole())\n          || isModeratorRole(userRoleKey())\n          || isModeratorRole(tokenRole())\n        );\n    }\n\n    function validCreatedModerationStatus() {\n      return !request.resource.data.keys().hasAny(['moderationStatus'])\n        || request.resource.data.moderationStatus == 'active';\n    }\n\n    function moderationFieldsOnly() {\n      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n        'moderationStatus',\n        'hiddenAt',\n        'hiddenBy',\n        'deletedAt',\n        'deletedBy',\n        'updatedAt'\n      ]);\n    }\n\n    function doesNotChangeModerationFields() {\n      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([\n        'moderationStatus',\n        'hiddenAt',\n        'hiddenBy',\n        'deletedAt',\n        'deletedBy'\n      ]);\n    }\n\n    function validModerationStatusUpdate() {\n      return request.resource.data.moderationStatus in ['active', 'hidden', 'deleted'];\n    }\n\n    function canModerateContentUpdate() {\n      return isAdminOrModerator()\n        && moderationFieldsOnly()\n        && validModerationStatusUpdate();\n    }\n\n    function feedSettings() {\n      return get(/databases/$(database)/documents/app_settings/campaign_feed).data;\n    }\n\n    function hasFeedSettings() {\n      return exists(/databases/$(database)/documents/app_settings/campaign_feed);\n    }\n\n    function allowUserPosts() {\n      return !hasFeedSettings() || feedSettings().allowUserPosts == true;\n    }\n\n    function allowGuestPosts() {\n      return hasFeedSettings() && feedSettings().allowGuestPosts == true;\n    }\n\n    function allowGuestReactions() {\n      return !hasFeedSettings() || feedSettings().allowGuestReactions == true;\n    }\n\n    function allowGuestComments() {\n      return !hasFeedSettings() || feedSettings().allowGuestComments == true;\n    }\n\n    function validPostBase(postId) {\n      return signedIn()\n        && request.resource.data.id == postId\n        && request.resource.data.authorId == request.auth.uid\n        && request.resource.data.keys().hasAll([\n          'id',\n          'authorId',\n          'authorName',\n          'authorRole',\n          'category',\n          'postType',\n          'text',\n          'imageUrl',\n          'campaignTitle',\n          'campaignGoal',\n          'campaignRaised',\n          'campaignStatus',\n          'createdAt',\n          'updatedAt',\n          'reactCount',\n          'commentCount',\n          'shareCount',\n          'isLiveCampaign'\n        ]);\n    }\n\n    function isCommunityCreate(postId) {\n      return validPostBase(postId)\n        && request.resource.data.category == 'community'\n        && request.resource.data.postType in ['note', 'photo']\n        && request.resource.data.isLiveCampaign == false\n        && validCreatedModerationStatus();\n    }\n\n    function canCreatePost(postId) {\n      return isAdminOrModerator()\n        && validPostBase(postId)\n        && (request.resource.data.category in ['community', 'official'])\n        && (request.resource.data.postType in ['note', 'photo', 'live_campaign'])\n        && validCreatedModerationStatus()\n        || (\n          signedIn()\n          && !isGuest()\n          && allowUserPosts()\n          && isCommunityCreate(postId)\n          && request.resource.data.authorRole in ['user', 'moderator']\n        )\n        || (\n          isGuest()\n          && allowGuestPosts()\n          && isCommunityCreate(postId)\n          && request.resource.data.authorRole == 'guest'\n        );\n    }\n\n    function canUpdatePostCounters() {\n      return signedIn()\n        && request.resource.data.diff(resource.data).affectedKeys()\n          .hasOnly(['reactCount', 'reactionCounts', 'commentCount', 'shareCount', 'updatedAt']);\n    }\n\n    function canUpdateOwnPost() {\n      return signedIn()\n        && resource.data.authorId == request.auth.uid\n        && request.resource.data.authorId == resource.data.authorId\n        && request.resource.data.category == resource.data.category\n        && request.resource.data.authorRole == resource.data.authorRole\n        && request.resource.data.postType == resource.data.postType\n        && doesNotChangeModerationFields();\n    }\n\n    function canManagePost(postId) {\n      return isAdminOrModerator()\n        || (\n          signedIn()\n          && get(/databases/$(database)/documents/campaign_posts/$(postId)).data.authorId == request.auth.uid\n        );\n    }\n\n    function isSafeOwnUserUpdate(userId) {\n      return signedIn()\n        && request.auth.uid == userId\n        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roleKey']);\n    }\n\n    function isFollowerCountMirrorUpdate(userId) {\n      return signedIn()\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])\n        && (\n          exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))\n          || existsAfter(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))\n        );\n    }\n\n    function isValidFollowRecord(expectedUserId) {\n      return request.resource.data.userId == expectedUserId\n        && request.resource.data.keys().hasAll(['userId', 'fullName', 'followedAt'])\n        && request.resource.data.keys().hasOnly([\n          'userId',\n          'fullName',\n          'email',\n          'profilePhotoUrl',\n          'profilePhotoLocalUri',\n          'role',\n          'status',\n          'followedAt'\n        ]);\n    }\n\n    function isValidPaymentMethod(methodId) {\n      return request.resource.data.id == methodId\n        && request.resource.data.type == methodId\n        && request.resource.data.type in ['gcash', 'maya', 'card']\n        && request.resource.data.displayName is string\n        && request.resource.data.maskedNumber is string\n        && request.resource.data.isDefault is bool\n        && request.resource.data.keys().hasOnly([\n          'id',\n          'type',\n          'displayName',\n          'maskedNumber',\n          'isDefault',\n          'createdAt',\n          'updatedAt'\n        ]);\n    }\n\n    function validReactionType(type) {\n      return type in ['like', 'heart', 'haha', 'sad', 'care', 'angry'];\n    }\n\n    function canCreateCampaignComment(postId, commentId) {\n      return signedIn()\n        && request.resource.data.id == commentId\n        && request.resource.data.postId == postId\n        && request.resource.data.authorId == request.auth.uid\n        && request.resource.data.authorRole in ['user', 'guest', 'admin', 'super_admin', 'moderator']\n        && request.resource.data.text is string\n        && request.resource.data.text.size() > 0\n        && request.resource.data.replyCount == 0\n        && validCreatedModerationStatus()\n        && (!isGuest() || allowGuestComments());\n    }\n\n    function canCreateCampaignReply(postId, commentId, replyId) {\n      return signedIn()\n        && request.resource.data.id == replyId\n        && request.resource.data.postId == postId\n        && request.resource.data.parentCommentId == commentId\n        && request.resource.data.authorId == request.auth.uid\n        && request.resource.data.authorRole in ['user', 'guest', 'admin', 'super_admin', 'moderator']\n        && request.resource.data.text is string\n        && request.resource.data.text.size() > 0\n        && validCreatedModerationStatus()\n        && (!isGuest() || allowGuestComments());\n    }\n\n    function canCreateOrUpdateReaction(actorId) {\n      return signedIn()\n        && actorId == request.auth.uid\n        && request.resource.data.actorId == request.auth.uid\n        && request.resource.data.actorRole in ['user', 'guest', 'admin', 'super_admin', 'moderator']\n        && validReactionType(request.resource.data.type)\n        && (!isGuest() || allowGuestReactions());\n    }\n\n    function canCreateNotification(notificationId) {\n      return signedIn()\n        && request.resource.data.id == notificationId\n        && request.resource.data.senderId == request.auth.uid\n        && (\n          request.resource.data.recipientId != request.auth.uid\n          || request.resource.data.type == 'donation_success'\n        )\n        && request.resource.data.type in [\n          'donation_success',\n          'new_donation_admin',\n          'campaign_added',\n          'campaign_updated',\n          'friend_request',\n          'friend_added',\n          'friend_removed',\n          'followed',\n          'unfollowed',\n          'mention_post',\n          'mention_comment',\n          'mention_reply',\n          'post_comment',\n          'comment_reply',\n          'reply_reply',\n          'post_reaction',\n          'comment',\n          'mention'\n        ]\n        && request.resource.data.title is string\n        && request.resource.data.message is string\n        && request.resource.data.message.size() > 0\n        && request.resource.data.isRead == false;\n    }\n\n    match /app_settings/campaign_feed {\n      allow read: if true;\n      allow create, update: if isAdmin();\n    }\n\n    match /users/{userId} {\n      allow read: if signedIn();\n      allow create: if isAdmin()\n        || (\n          signedIn()\n          && request.auth.uid == userId\n          && !request.resource.data.keys().hasAny(['role', 'roleKey'])\n        );\n      allow update: if isAdmin()\n        || isSafeOwnUserUpdate(userId)\n        || isFollowerCountMirrorUpdate(userId)\n        || (\n          signedIn()\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers'])\n        );\n      allow delete: if isAdmin();\n\n      match /following/{targetUserId} {\n        allow read: if signedIn();\n        allow create, update: if signedIn()\n          && request.auth.uid == userId\n          && targetUserId != userId\n          && isValidFollowRecord(targetUserId);\n        allow delete: if signedIn()\n          && request.auth.uid == userId\n          && targetUserId != userId;\n      }\n\n      match /followers/{followerUserId} {\n        allow read: if signedIn();\n        allow create, update: if signedIn()\n          && request.auth.uid == followerUserId\n          && followerUserId != userId\n          && isValidFollowRecord(followerUserId);\n        allow delete: if signedIn()\n          && request.auth.uid == followerUserId\n          && followerUserId != userId;\n      }\n\n      match /payment_methods/{methodId} {\n        allow read: if signedIn() && request.auth.uid == userId;\n        allow create, update: if signedIn()\n          && request.auth.uid == userId\n          && isValidPaymentMethod(methodId);\n        allow delete: if signedIn() && request.auth.uid == userId;\n      }\n    }\n\n    match /campaign_posts/{postId} {\n      allow read: if true;\n      allow create: if canCreatePost(postId);\n      allow update: if isAdmin()\n        || canModerateContentUpdate()\n        || canUpdateOwnPost()\n        || canUpdatePostCounters();\n      allow delete: if canManagePost(postId);\n\n      match /reactions/{reactionId} {\n        allow read: if true;\n        allow create, update: if canCreateOrUpdateReaction(reactionId);\n        allow delete: if canManagePost(postId)\n          || (signedIn() && reactionId == request.auth.uid);\n      }\n\n      match /comments/{commentId} {\n        allow read: if true;\n        allow create: if canCreateCampaignComment(postId, commentId);\n        allow update: if isAdmin()\n          || canModerateContentUpdate()\n          || (\n            signedIn()\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount', 'updatedAt'])\n            && (!isGuest() || allowGuestComments())\n          );\n        allow delete: if canManagePost(postId)\n          || (\n            signedIn()\n            && (\n              resource.data.authorId == request.auth.uid\n              || resource.data.userId == request.auth.uid\n            )\n          );\n\n        match /replies/{replyId} {\n          allow read: if true;\n          allow create: if canCreateCampaignReply(postId, commentId, replyId);\n          allow update: if isAdmin()\n            || canModerateContentUpdate()\n            || (\n              signedIn()\n              && resource.data.authorId == request.auth.uid\n              && doesNotChangeModerationFields()\n            );\n          allow delete: if canManagePost(postId)\n            || (\n              signedIn()\n              && resource.data.authorId == request.auth.uid\n            );\n        }\n      }\n    }\n\n    match /notifications/{notificationId} {\n      allow read: if isAdmin()\n        || (signedIn() && resource.data.recipientId == request.auth.uid);\n      allow create: if canCreateNotification(notificationId);\n      allow update: if isAdmin()\n        || (\n          signedIn()\n          && resource.data.recipientId == request.auth.uid\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])\n        );\n      allow delete: if isAdmin()\n        || (signedIn() && resource.data.recipientId == request.auth.uid);\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-02T11:33:47.966543Z","metadata":{"services":["cloud.firestore"]}}
