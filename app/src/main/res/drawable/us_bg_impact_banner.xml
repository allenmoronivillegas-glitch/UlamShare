<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D0E4FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:right="0dp" android:top="0dp" android:bottom="0dp" android:left="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#D0E4FF" />
            <stroke
                android:width="3dp"
                android:color="#1A5FD4" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
