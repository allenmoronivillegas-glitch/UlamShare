<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/registerRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="28dp"
        android:paddingBottom="40dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_back_btn_blue"
            android:contentDescription="Go back"
            android:padding="10dp"
            android:src="@drawable/ic_chevron_left_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Step Indicator -->
        <TextView
            android:id="@+id/tvStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:letterSpacing="0.04"
            android:text="Step 1 / 3"
            android:textColor="#93C5FD"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Progress Dots -->
        <LinearLayout
            android:id="@+id/progressDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivBack">

            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_dot_active" />

            <View
                android:layout_width="24dp"
                android:layout_height="4dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_dot_inactive" />

            <View
                android:layout_width="24dp"
                android:layout_height="4dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_dot_inactive" />

        </LinearLayout>

        <!-- Heading -->
        <TextView
            android:id="@+id/tvJoinHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingMultiplier="1.2"
            android:text="Join HopeGive ✨"
            android:textColor="#1A1C1E"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressDots" />

        <TextView
            android:id="@+id/tvJoinSubHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Create an account to track your impact"
            android:textColor="#6C757D"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvJoinHeader" />

        <!-- Form -->
        <LinearLayout
            android:id="@+id/formContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvJoinSubHeader">

            <!-- Full Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FULL NAME"
                android:textColor="#1A1C1E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/rounded_input_border"
                    android:hint="Example"
                    android:inputType="textPersonName"
                    android:paddingStart="48dp"
                    android:paddingEnd="16dp"
                    android:textColor="#1A1C1E"
                    android:textColorHint="#ADB5BD"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_person"
                    app:tint="#ADB5BD"
                    android:contentDescription="Person icon" />
            </FrameLayout>

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="EMAIL ADDRESS"
                android:textColor="#1A1C1E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/rounded_input_border"
                    android:hint="example@example.com"
                    android:inputType="textEmailAddress"
                    android:paddingStart="48dp"
                    android:paddingEnd="16dp"
                    android:textColor="#1A1C1E"
                    android:textColorHint="#ADB5BD"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_email"
                    app:tint="#ADB5BD"
                    android:contentDescription="Email icon" />
            </FrameLayout>

            <!-- Mobile -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="MOBILE NUMBER"
                android:textColor="#1A1C1E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etMobile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/rounded_input_border"
                    android:hint="09123456789"
                    android:inputType="phone"
                    android:paddingStart="48dp"
                    android:paddingEnd="16dp"
                    android:textColor="#1A1C1E"
                    android:textColorHint="#ADB5BD"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_phone"
                    app:tint="#ADB5BD"
                    android:contentDescription="Phone icon" />
            </FrameLayout>

            <!-- Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="PASSWORD"
                android:textColor="#1A1C1E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/rounded_input_border"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:textColor="#1A1C1E"
                    android:textColorHint="#ADB5BD"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_lock"
                    app:tint="#ADB5BD"
                    android:contentDescription="Lock icon" />

                <ImageButton
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="16dp"
                    android:background="@null"
                    android:src="@drawable/ic_eye"
                    app:tint="#ADB5BD"
                    android:contentDescription="Toggle password visibility" />
            </FrameLayout>

            <!-- Verification Method -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="VERIFICATION METHOD"
                android:textColor="#1A1C1E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <RadioGroup
                android:id="@+id/verificationMethodGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checkedButton="@+id/rbSms"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <RadioButton
                    android:id="@+id/rbSms"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_radio_option_selected"
                    android:buttonTint="@android:color/transparent"
                    android:checked="true"
                    android:drawableStart="@drawable/ic_radio_selected"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="SMS"
                    android:textColor="#1A1C1E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbEmail"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_radio_option_unselected"
                    android:buttonTint="@android:color/transparent"
                    android:drawableStart="@drawable/ic_radio_unselected"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Email"
                    android:textColor="#ADB5BD"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </RadioGroup>

        </LinearLayout>

        <!-- Send OTP Button -->
        <Button
            android:id="@+id/btnSendOtp"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#2172E5"
            android:text="Send OTP via SMS"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/formContainer" />

        <!-- Divider -->
        <LinearLayout
            android:id="@+id/dividerContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnSendOtp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#E9ECEF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="or continue with"
                android:textColor="#ADB5BD"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#E9ECEF" />

        </LinearLayout>

        <!-- Google Sign-Up -->
        <LinearLayout
            android:id="@+id/btnGoogleSignUp"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_google_signup_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerContainer">

            <TextView
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="G"
                android:textColor="#4285F4"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGoogleSignUp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Sign up with Google"
                android:textColor="#3C4043"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="24dp"
                android:layout_height="match_parent" />

        </LinearLayout>

        <!-- Facebook Sign-Up -->
        <LinearLayout
            android:id="@+id/btnFacebookSignUp"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_google_signup_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnGoogleSignUp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="f"
                android:textColor="#1877F2"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/sign_up_with_facebook"
                android:textColor="#3C4043"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="24dp"
                android:layout_height="match_parent" />

        </LinearLayout>

        <!-- Login Link -->
        <TextView
            android:id="@+id/tvLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="4dp"
            android:text="Already have an account? Log in"
            android:textColor="#6C757D"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnFacebookSignUp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
